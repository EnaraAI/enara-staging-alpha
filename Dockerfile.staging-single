# ENARA staging, single service ($0 Railway plan): the backend serves the API
# and the built SPA from one container. Used only by railway.staging-single.toml;
# the existing frontend/backend Dockerfiles and Railway configs are unchanged.

FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Same-origin API: the SPA calls /api/<path> on this service.
ENV VITE_API_URL=/api
RUN npx vite build

FROM node:22-alpine AS api
WORKDIR /api
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
COPY --from=api /api/package.json ./
COPY --from=api /api/node_modules ./node_modules
COPY --from=api /api/dist ./dist
COPY --from=web /web/dist ./public
# Staging-only switches (ignored unless ENARA_STAGING=true). NODE_ENV and all
# secrets are set on the Railway service, never baked in.
ENV SERVE_FRONTEND_DIR=/app/public \
    DB_IDLE_DISCONNECT_MS=240000 \
    NODE_OPTIONS=--max-old-space-size=256
USER node
CMD ["node", "dist/index.js"]

{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": false, "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "types": ["vite/client"]
  },
  "include": ["src"],
  // The copied lms-test files are checked with lms-test's own options: npx tsc -p tsconfig.lms.json
  "exclude": ["src/lms"]
}

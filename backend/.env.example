NODE_ENV=production
PORT=3001

# Database
MONGODB_URI=
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=enara-backend
JWT_AUDIENCE=enara-platform
BCRYPT_ROUNDS=12

# Browser/API security
FRONTEND_URL=https://enara.app
CORS_ALLOWED_ORIGINS=https://enara.app,https://www.enara.app
TRUST_PROXY=true
REQUEST_BODY_LIMIT=1mb
FORM_BODY_LIMIT=100kb
SERVE_LOCAL_UPLOADS=false
UPLOAD_DIR=uploads

# Public "Try Demo" flow (enara.app -> enara-platform /demo). Leave false
# everywhere except the dedicated demo deploy. Run `npm run seed:demo` once
# DEMO_MODE_ENABLED=true so POST /api/auth/demo-login has accounts to issue
# tokens for. If DEMO_MODE_ENABLED=true is ever set with NODE_ENV=production,
# DEMO_MODE_PRODUCTION_CONFIRM=true must also be set, or the app refuses to
# boot -- this is a deliberate double opt-in, not an oversight.
DEMO_MODE_ENABLED=false
DEMO_MODE_PRODUCTION_CONFIRM=false

# AI services
ENARA_ORCHESTRATOR_URL=
ENARA_API_KEY=
AI_ENGINE_URL=
AI_ENGINE_TIMEOUT_MS=15000
INGEST_HMAC_SECRET=
INGEST_HMAC_TOLERANCE_SECONDS=300
INGEST_ACCEPT_LEGACY_SIGNATURES=false
# INGESTION_CALLBACK_URL is set on the AI *engine*, not here. Give the engine team:
#   https://<this-service>.onrender.com/api/ingestion/callback

# Upload storage
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
# Prefer instance/task roles in production. Set both only when static keys are required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

{
  "name": "enara-ai-be",
  "version": "1.0.0",
  "description": "Enara AI Backend - Curriculum Center API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "benchmark:grading": "tsx src/scripts/gradingBenchmark.ts",
    "lms:keys": "tsx src/scripts/lmsKeys.ts",
    "lms:drop": "tsx src/scripts/lmsDropCollections.ts",
    "enrollment:drop": "tsx src/scripts/enrollmentDrop.ts",
    "enrollment:backfill": "tsx src/scripts/enrollmentBackfill.ts",
    "enrollment:shadow-report": "tsx src/scripts/enrollmentShadowReport.ts",
    "enrollment:multi-class-undo": "tsx src/scripts/enrollmentMultiClassUndo.ts",
    "pdpl:retention": "tsx src/scripts/pdplRetention.ts",
    "content:export": "tsx src/scripts/contentExport.ts",
    "content:import": "tsx src/scripts/contentImport.ts",
    "ledger:backfill": "tsx src/scripts/gradeLedgerBackfill.ts",
    "eval:subjects": "tsx src/scripts/subjectEval.ts",
    "test:closed-coverage": "vitest run test/assessment/closedGraders.test.ts --coverage.enabled --coverage.provider=v8 --coverage.include='src/assessment/grading-engine/graders/closed/**' --coverage.thresholds.lines=95 --coverage.thresholds.branches=95 --coverage.thresholds.functions=95 --coverage.thresholds.statements=95",
    "bench:assessment": "tsx src/scripts/assessmentBench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@types/pg": "^8.11.0",
    "@vercel/functions": "^3.10.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "jose": "6.2.17",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^14.9.1",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "quickjs-emscripten-core": "0.32.0",
    "resend": "^6.38.1",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.7.2",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "mongodb-memory-server": "^10.3.0",
    "openapi-types": "^12.1.3",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4",
    "wrangler": "^4"
  }
}

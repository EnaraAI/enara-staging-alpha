# ENARA staging template (non-secret). Copy to a staging-only env file owned
# by the staging user (chmod 600). Never point any value at production.
# Values are intentionally blank: fill them from the staging secret store.

# Turns on the startup isolation guard (src/config/stagingGuard.ts). Run from a
# directory without .env: the guard refuses values inherited from a .env file.
ENARA_STAGING=true
# Approved Option A: development mode with the staging guard on. Postgres
# (DATABASE_URL), the orchestrator and the AI engine are not required.
NODE_ENV=development
PORT=
# Dedicated staging database and user, e.g. database enara_staging_alpha.
MONGODB_URI=
# Not required with Option A (development); leave unset.
DATABASE_URL=
# New secrets for staging only; never reuse production values.
JWT_SECRET=
INGEST_HMAC_SECRET=
CRON_SECRET=
# Staging subdomain only.
FRONTEND_URL=
APP_URL=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=1

# Safety defaults for staging.
RUN_MIGRATIONS_ON_START=false
AI_PAUSED=true
DEMO_MODE_ENABLED=false
REGISTRATION_INVITE_ONLY=true
REMINDERS_ENABLED=false
REMINDER_TEST_RECIPIENT=

# Storage: a staging-only bucket with its own credentials, or leave R2 unset and use UPLOAD_DIR.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UPLOAD_DIR=
SERVE_LOCAL_UPLOADS=false

# AI providers (staging keys). Leave ANAM unset: avatar exams are not implemented.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_EXAM_STT_MODEL=

# External services: staging endpoints only (or isolated values).
ENARA_ORCHESTRATOR_URL=
ENARA_API_KEY=
AI_ENGINE_URL=

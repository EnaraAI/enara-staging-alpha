{
  "alias": "parent-invite",
  "number": "P1",
  "group": "parents",
  "status": "draft: not approved, not in TEMPLATE_REGISTRY or any bundle, never sent",
  "name": "Enara – Parents: invitation with link code",
  "from": "The Enara Team <noreply@test.enara.app>",
  "recipient": "Parent (email given by the school: single code or CSV invite)",
  "trigger": "School sends a parent link code (single, or CSV invitations P5)",
  "delivery": "immediate",
  "frequency": "Immediate; once per invite / code",
  "languages": [
    "en",
    "ar"
  ],
  "files": {
    "en": "parent-invite-en.html",
    "ar": "parent-invite-ar.html"
  },
  "subject": {
    "en": "{{{SCHOOL_NAME}}} invites you to follow {{{CHILD_NAME}}}'s English on Enara",
    "ar": "{{{SCHOOL_NAME}}} تدعوك لمتابعة تقدّم {{{CHILD_NAME}}} في اللغة الإنجليزية على إنارة"
  },
  "variables": [
    {
      "key": "NAME",
      "type": "string",
      "fallback_value": {
        "en": "there",
        "ar": "بك"
      },
      "sample": {
        "en": "Sara",
        "ar": "سارة"
      }
    },
    {
      "key": "CHILD_NAME",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "Omar",
        "ar": "عمر"
      }
    },
    {
      "key": "SCHOOL_NAME",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "Nile Valley International School",
        "ar": "مدرسة وادي النيل الدولية"
      }
    },
    {
      "key": "LINK_CODE",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "ENR-7K4M-Q2XD",
        "ar": "ENR-7K4M-Q2XD"
      }
    },
    {
      "key": "EXPIRES_IN",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "7 days",
        "ar": "7 أيام"
      }
    },
    {
      "key": "ACTION_URL",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "https://enara.app/parents/link",
        "ar": "https://enara.app/parents/link"
      }
    }
  ]
}

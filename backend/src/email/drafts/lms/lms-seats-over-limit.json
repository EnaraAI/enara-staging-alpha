  "languages": [
    "en",
    "ar"
  ],
  "files": {
    "en": "lms-seats-over-limit-en.html",
    "ar": "lms-seats-over-limit-ar.html"
  },
  "subject": {
    "en": "{{{SCHOOL_NAME}}} is over its Enara seat limit",
    "ar": "تجاوزت {{{SCHOOL_NAME}}} حدّ مقاعد إنارة"

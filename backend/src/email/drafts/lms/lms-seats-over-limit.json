        "en": "there",
        "ar": "بك"
      },
      "sample": {
        "en": "Mona",
        "ar": "منى"
      }
    },
    {
      "key": "SCHOOL_NAME",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "Nile Valley International School",
        "ar": "مدرسة وادي النيل الدولية"
      }
    },
    {
      "key": "SEATS_USED",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "512",
        "ar": "512"
      }
    },
    {
      "key": "SEAT_LIMIT",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "500",
        "ar": "500"
      }
    },
    {
      "key": "ACTION_URL",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "https://enara.app/?page=lms&platform=lmsp_7f3a9c21e4&tab=seats",
        "ar": "https://enara.app/?page=lms&platform=lmsp_7f3a9c21e4&tab=seats"
      }
    }
  ]
}

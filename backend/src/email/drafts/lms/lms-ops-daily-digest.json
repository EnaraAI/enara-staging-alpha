{
  "alias": "lms-ops-daily-digest",
  "number": "E5",
  "group": "lms",
  "status": "draft: not approved, not in TEMPLATE_REGISTRY or any bundle, never sent",
  "name": "Enara – LMS ops: daily summary",
  "from": "The Enara Team <noreply@test.enara.app>",
  "recipient": "ENARA ops (LMS_OPS_EMAILS)",
  "trigger": "Daily cron: pending approvals > 24 h, billing flags, dead grade jobs (all schools), unknown-LMS launches, cookieless share, roster failures, key problems, switch-offs",
  "delivery": "digest",
  "frequency": "Daily; only if any row is non-zero",
  "languages": [
    "en"
  ],
  "files": {
    "en": "lms-ops-daily-digest-en.html"
  },
  "subject": {
    "en": "[LMS] Daily summary {{{DATE}}}"
  },
  "variables": [
    {
      "key": "DATE",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "18 November 2026"
      }
    },
    {
      "key": "PENDING_OVER_24H",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "1"
      }
    },
    {
      "key": "BILLING_FLAGS",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "1"
      }
    },
    {
      "key": "DEAD_JOBS",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "6"
      }
    },
    {
      "key": "ROSTER_FAILED",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "3"
      }
    },
    {
      "key": "KEY_PROBLEMS",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "1"
      }
    },
    {
      "key": "SWITCHED_OFF",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "0"
      }
    },
    {
      "key": "UNKNOWN_LMS_LAUNCHES",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "2"
      }
    },
    {
      "key": "COOKIELESS_TOP",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "Nile Valley International School: 42%"
      }
    },
    {
      "key": "ACTION_URL",
      "type": "string",
      "fallback_value": null,
      "sample": {
        "en": "https://enara.app/?page=lms"
      }
    }
  ]
}

# Staging frontend image (Railway, service enara-staging-frontend).
# Reproducible install from the lockfile; the runtime image carries the
# production dependencies the bundled server needs (express, cors, ...).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Browser API calls go through this server's same-origin proxy to BACKEND_URL.
ENV VITE_API_URL=/api/railway
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/server.cjs"]
